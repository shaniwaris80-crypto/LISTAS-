{
  "rules": {
    "arslanListas": {
      "arslan-listas-next-v1": {
        "$owner": {
          "document": {
            ".read": "auth != null && (auth.uid === $owner || root.child('arslanListas').child('arslan-listas-next-v1').child($owner).child('members').child(auth.uid).val() === true)",
            ".write": "auth != null && (auth.uid === $owner || root.child('arslanListas').child('arslan-listas-next-v1').child($owner).child('members').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['revision', 'data']) && newData.child('revision').isNumber() && newData.child('revision').val() >= 1 && newData.child('data').hasChildren(['day','destinations','catalog'])"
          },
          "members": {
            ".read": "auth != null && auth.uid === $owner",
            "$member": {
              ".read": "auth != null && (auth.uid === $owner || auth.uid === $member)",
              ".write": "auth != null && auth.uid === $owner",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}
